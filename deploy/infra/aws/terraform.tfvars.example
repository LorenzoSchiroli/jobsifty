aws_region           = "eu-central-1"
domain               = "jobsifty.com"
cloudflare_zone_id   = "00000000000000000000000000000000"
manage_dns      = false
# ghcr_username / ghcr_token: leave unset for public packages (anonymous pull).
frontend_image       = "ghcr.io/OWNER/jobsifty-frontend:TAG"
backend_image        = "ghcr.io/OWNER/jobsifty-backend:TAG"
ingestion_image      = "ghcr.io/OWNER/jobsifty-ingestion:TAG"
pgtools_image        = "ghcr.io/OWNER/jobsifty-pgtools:TAG"
alert_email          = "you@example.com"
groq_model_large     = "openai/gpt-oss-120b"
groq_model_base      = "qwen/qwen3-32b"
offer_query          = "machine learning engineer"
# groq_api_key / cloudflare_api_token / adzuna_* / tinyfish_api_key / exa_api_key / tavily_api_key via TF_VAR_ or terraform.tfvars (gitignored)
# Private GHCR packages only: set ghcr_username + ghcr_token (PAT, read:packages).
