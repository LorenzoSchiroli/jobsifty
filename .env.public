# Committed, non-secret configuration. Secrets stay in local `.env` (see
# `.env.example`). Keep values UNQUOTED (same rule as `.env` for k8s).

# Groq model IDs (not API keys)
GROQ_MODEL_LARGE=openai/gpt-oss-120b
GROQ_MODEL_BASE=openai/gpt-oss-20b

# Ingestion CronJob / compose query
OFFER_QUERY=machine learning engineer
# Companies enriched per ingestion run (2 web searches + 1 Groq call each); 0 disables
COMPANY_ENRICH_PER_RUN=6
# Web search providers, tried in order (each needs its *_API_KEY in .env)
SEARCH_PROVIDERS=tinyfish,exa,tavily

# JWT lifetime
ACCESS_TOKEN_EXPIRE_DAYS=7

# Extra browser origins for the API (localhost:3000 is always allowed).
CORS_ORIGINS=https://app.jobsifty.com

# Default Storage Box dump prefix (host/user/password stay in `.env`)
BACKUP_SBOX_PATH=backups/jobsifty

# Public API base URL baked into the frontend image at build time (Vite).
# Local compose overrides via Dockerfile build-arg (localhost:8000).
VITE_API_URL=https://api.jobsifty.com
