# Secrets and private runtime config (copy to gitignored `.env`).
# Non-secret, committed config lives in `.env.public`.

GROQ_API_KEY=

# Adzuna API credentials — free tier at https://developer.adzuna.com/
ADZUNA_APP_ID=
ADZUNA_APP_KEY=

# Web search for company enrichment: a pool tried in this order (SEARCH_PROVIDERS
# in .env.public); set any subset, providers without a key are skipped.
# TinyFish — free, rate limited (30/min, 500/hour) — https://tinyfish.ai
TINYFISH_API_KEY=
# Exa — $10/month free credits — https://exa.ai
EXA_API_KEY=
# Tavily — 1,000 searches/month free — https://tavily.com
TAVILY_API_KEY=

SECRET_KEY=change-me-generate-with-python-secrets


# Used by the singleton backend worker for nightly Postgres dumps to a
# Hetzner Storage Box. Create these values in the Kubernetes Secret; do not
# commit real Storage Box credentials. When unset, the worker skips backups.
# Path default lives in `.env.public` (BACKUP_SBOX_PATH).
BACKUP_SBOX_HOST=
BACKUP_SBOX_USER=
# BACKUP_SBOX_RCLONE_PASS is the output of `rclone obscure <password>`.
# Generate it outside Git and store only the obscured value in the Secret.
# BACKUP_SBOX_RCLONE_PASS=
